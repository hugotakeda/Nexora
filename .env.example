# Copie este arquivo para ".env" (na mesma pasta) e ajuste se precisar.
# Os valores abaixo já batem com o docker-compose.yml: com Docker, não precisa mudar nada.
DB_HOST=localhost
DB_PORT=3306
DB_USER=nexora
DB_PASSWORD=nexora
DB_NAME=nexora

# Empresa que a aplicação atende: EMP-1 (NEXORA Field) ou EMP-2 (NEXORA Core)
EMPRESA_ID=EMP-1

# Porta da aplicação web
PORT=3000
